# Technical vertical slice (Giai đoạn 1)
APP_NAME=tro-ly-hanh-chinh-mvp
APP_ENV=development
LOG_LEVEL=INFO

# Web and Core Backend
WEB_ORIGIN=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
SESSION_SIGNING_SECRET=replace-with-a-random-development-secret
SESSION_TTL_SECONDS=86400

# PostgreSQL
POSTGRES_DB=hanh_chinh_mvp
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://app_user:change-me@postgres:5432/hanh_chinh_mvp

# AI Service: mock first, hosted only after company approval, local later
AI_SERVICE_URL=http://ai-service:8001
AI_REQUEST_TIMEOUT_SECONDS=30
LLM_PROVIDER=mock

# Approved hosted provider (leave empty when LLM_PROVIDER is not hosted)
OPENAI_API_KEY=
OPENAI_MODEL=

# Local provider for Giai đoạn 3
LOCAL_LLM_BASE_URL=http://local-model:8080/v1
LOCAL_LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=300
