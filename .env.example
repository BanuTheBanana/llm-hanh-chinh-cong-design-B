# Technical vertical slice (Giai đoạn 1)
# Sao chép file này thành .env. Không commit .env hoặc secret thật.
COMPOSE_PROJECT_NAME=hanh-chinh-g1
APP_NAME=tro-ly-hanh-chinh-mvp
APP_ENV=development
LOG_LEVEL=INFO

# Cổng được công bố trên máy host
WEB_PORT=3000
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
POSTGRES_PORT=5432

# Web và Core Backend
WEB_ORIGIN=http://localhost:3000
WEB_ORIGINS=http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
API_HOST=0.0.0.0
API_PORT=8000
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=hanh_chinh_mvp
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-local-only
# Tùy chọn: để trống để Compose tạo kết nối Backend từ POSTGRES_* ở trên.
# Chỉ đặt DSN đầy đủ khi cần chủ động override toàn bộ cấu hình DB_*.
DATABASE_URL=

# AI Service - G1 chỉ dùng MockProvider
# Base origin only; Backend selects the versioned internal route.
AI_SERVICE_URL=http://ai-service:8001
AI_REQUEST_TIMEOUT_SECONDS=3
LLM_PROVIDER=mock
# Grounded G2 hiện chỉ bật template offline, không gọi provider ngoài.
GROUNDED_PROVIDER=template
LLM_MAX_OUTPUT_TOKENS=300
GROUNDED_MAX_OUTPUT_TOKENS=500
MOCK_MODE=success
MOCK_LATENCY_MS=10
# Phải lớn hơn AI_REQUEST_TIMEOUT_SECONDS khi kiểm thử timeout từ Backend.
MOCK_TIMEOUT_SECONDS=35

# RAG is off in the G1 stack. compose.g2.yaml overrides these values with the
# synthetic D0 fixture for an offline G2 integration smoke.
RAG_ENABLED=false
RAG_CORPUS_VERSION=
RAG_TOP_K=5
RAG_ALLOW_FIXTURES=false

# Dành cho giai đoạn sau. Để trống trong G1.
# Không gửi dữ liệu công ty ra hosted provider khi chưa có phê duyệt bằng văn bản.
OPENAI_API_KEY=
OPENAI_MODEL=

# Dành cho Giai đoạn 3.
# Mặc định khi AI Service chạy trong Docker và llama-server chạy trên máy host.
# Overlay compose.g3.docker.yaml sẽ tự thay URL bằng service llama-server nội bộ.
LOCAL_LLM_BASE_URL=http://host.docker.internal:8080/v1
# API alias phải khớp Identifier contract, không dùng dấu "/" của repository ID.
LOCAL_LLM_MODEL=Qwen3-1.7B
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_CONTEXT=4096
# Guard thô theo ký tự; llama-server vẫn phải chạy đúng context và --no-context-shift.
LOCAL_LLM_MAX_PROMPT_CHARACTERS=8000
LOCAL_LLM_MAX_OUTPUT_TOKENS=500
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_TOP_P=0.8
LOCAL_LLM_TOP_K=20
LOCAL_LLM_MIN_P=0.0
LOCAL_LLM_PRESENCE_PENALTY=1.5
LOCAL_LLM_SEED=42
LOCAL_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,local-model,host.docker.internal
# Chỉ bật trong overlay G3 dùng Qwen local; template/hosted provider không được nhận D2.
LOCAL_LLM_ALLOW_D2_COMPANY_DATA=false

# File Qwen GGUF nằm ngoài Git, chỉ dùng khi chạy compose.g3.docker.yaml.
G3_MODEL_HOST_PATH=D:/duong-dan-rieng/models/Qwen3-1.7B-Q8_0.gguf

# G3 D2: thư mục build riêng tư nằm ngoài Git và được mount read-only vào Backend.
G3_PRIVATE_DATASET_HOST_PATH=D:/duong-dan-rieng/company-tthc-demo10-v1
G3_DATASET_VERSION=company-tthc-9c38dde8-v1-demo10-v1
G3_EXPECTED_ROWS=10
G3_CORPUS_SHA256=3cf57b03c3c10d580e1dfe298b08728dd910198379c80bc30c338ed6d0e99181

# G5 local-only overlay. scripts/demo-g5.ps1 supplies these values.
# Never commit a real reviewer token or private corpus path.
G5_EMBEDDING_MODEL_HOST_PATH=D:/duong-dan-rieng/models/Qwen3-Embedding-0.6B-Q8_0.gguf
G5_INTENT_MODEL_HOST_PATH=D:/duong-dan-rieng/models/qwen3-4b-instruct-2507-q8_0.gguf
G5_INTENT_ADAPTER_HOST_PATH=D:/duong-dan-rieng/adapters/intent-hard-v2-r16.gguf
G5_SOURCE_REVIEW_TOKEN=
EMBEDDING_SERVER_PORT=8095
SOURCE_SERVICE_PORT=8096
INTENT_SERVER_PORT=8087
