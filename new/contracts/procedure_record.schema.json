{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"procedure_record.schema.json",
  "title":"ProcedureRecord",
  "type":"object",
  "properties":{
    "procedure_id":{"type":"string"},
    "canonical_name":{"type":"string"},
