  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "fragment_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Fragment Id"
          },
          "source_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Url"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fragment_id",
          "source_id",
          "title",
          "url",
          "metadata"
        ],
        "title": "Citation"
      },
      "ConversationInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "default": "Cuộc trò chuyện mới"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ConversationInput"
      },
      "ConversationOutput": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationOutput"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorOutput": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorOutput"
      },
      "Filters": {
        "properties": {
          "procedure_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Procedure Id"
          },
          "jurisdiction": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdiction"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Filters"
      },
      "Grounding": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "evidence_bundle_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Bundle Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ANSWER",
              "NEED_CLARIFICATION",
              "INSUFFICIENT_DATA"
            ],
            "title": "Status"
          },
          "corpus_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Corpus Version"
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "D0_SYSTEM_SMOKE",
              "D1_PUBLIC_DEMO"
            ],
            "title": "Data Classification"
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
