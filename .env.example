# Technical vertical slice (Giai đoạn 1)
# Sao chép file này thành .env. Không commit .env hoặc secret thật.
COMPOSE_PROJECT_NAME=hanh-chinh-g1
APP_NAME=tro-ly-hanh-chinh-mvp
APP_ENV=development
LOG_LEVEL=INFO

# Cổng được công bố trên máy host
WEB_PORT=3000
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
POSTGRES_PORT=5432

# Web và Core Backend
WEB_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
API_HOST=0.0.0.0
API_PORT=8000
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=hanh_chinh_mvp
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-local-only
# Tùy chọn: để trống để Compose tạo kết nối Backend từ POSTGRES_* ở trên.
# Chỉ đặt DSN đầy đủ khi cần chủ động override toàn bộ cấu hình DB_*.
DATABASE_URL=

# AI Service - G1 chỉ dùng MockProvider
# Base origin only; Backend appends /internal/v1/generate.
AI_SERVICE_URL=http://ai-service:8001
AI_REQUEST_TIMEOUT_SECONDS=3
LLM_PROVIDER=mock
LLM_MAX_OUTPUT_TOKENS=300
MOCK_MODE=success
MOCK_LATENCY_MS=10
# Phải lớn hơn AI_REQUEST_TIMEOUT_SECONDS khi kiểm thử timeout từ Backend.
MOCK_TIMEOUT_SECONDS=35

# Dành cho giai đoạn sau. Để trống trong G1.
# Không gửi dữ liệu công ty ra hosted provider khi chưa có phê duyệt bằng văn bản.
OPENAI_API_KEY=
OPENAI_MODEL=

# Dành cho Giai đoạn 3.
LOCAL_LLM_BASE_URL=http://local-model:8080/v1
LOCAL_LLM_MODEL=
