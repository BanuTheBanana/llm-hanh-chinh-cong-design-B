# Application
APP_NAME=luat-dung-luc
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080

# Session and authentication - replace all example secrets locally
SESSION_COOKIE_NAME=ldl_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800
SESSION_SIGNING_SECRET=change-me-with-a-random-secret
OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
PHONE_LOOKUP_HMAC_KEY=change-me-with-a-random-secret
PII_ENCRYPTION_KEY=change-me-with-a-random-secret

# PostgreSQL
POSTGRES_DB=luat_dung_luc
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://app_user:change-me@postgres:5432/luat_dung_luc
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Redis queue, cache, lock and realtime
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_MESSAGES=conversation_jobs
REDIS_STREAM_INGESTION=ingestion_jobs
REDIS_CONSUMER_GROUP=llm_workers
CONVERSATION_LOCK_TTL_SECONDS=180
JOB_MAX_RETRIES=3
MAX_QUEUED_MESSAGES_PER_USER=5

# Socket.IO
SOCKET_IO_PATH=/socket.io
SOCKET_ACK_TIMEOUT_MS=10000
SOCKET_MAX_DISCONNECTION_MS=120000

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_LEGAL=legal_provisions
QDRANT_COLLECTION_USER_UPLOADS=user_uploads

# Object storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_RAW=raw-documents
S3_BUCKET_UPLOADS=user-uploads
S3_SECURE=false
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Local model runtime
LLM_BASE_URL=http://llm-server:8001/v1
LLM_API_KEY=local-not-secret
LLM_MODEL_ID=Qwen3-4B-Instruct-2507
LLM_MAX_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CONCURRENT_REQUESTS=1

# Retrieval models
EMBEDDING_MODEL_ID=BAAI/bge-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RETRIEVAL_CANDIDATE_K=50
RERANK_TOP_K=8

# Context and memory
RECENT_MESSAGE_COUNT=12
SUMMARY_TRIGGER_TOKENS=5000
SUMMARY_TARGET_TOKENS=800
MAX_MEMORY_FACTS=30
CONTEXT_EVIDENCE_TOKEN_BUDGET=3500
MEMORY_RETENTION_DAYS=90

# Backend-managed case routing
CASE_ROUTER_MODE=rules
CASE_ROUTER_MAX_CANDIDATES=10
CASE_ROUTER_CLARIFY_ON_AMBIGUOUS=true
CASE_LOCK_TTL_SECONDS=60

# Ingestion and safety
ENABLE_MALWARE_SCAN=true
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_SCAN=true
ACTIVE_INDEX_VERSION=development

# Observability
OTEL_SERVICE_NAME=luat-dung-luc-api
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
AUDIT_LOG_ENABLED=true
