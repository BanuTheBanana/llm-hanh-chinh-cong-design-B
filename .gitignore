# Local environment secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/

# JavaScript
node_modules/
dist/
test-results/

# Local runtime data. Public demo corpus is intentionally versioned for G2.
data/*
!data/demo_public/
!data/demo_public/**
!data/demo_synthetic/
!data/demo_synthetic/**
# Company-provided source data. Keep raw files outside Git until governance,
# licensing, PII handling and an approved storage location are documented.
dataset/
uploads/
models/
logs/

# Generated evaluation reports; keep only the directory placeholder in Git.
evaluation/reports/*
!evaluation/reports/.gitkeep
